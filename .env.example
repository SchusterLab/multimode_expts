# Per-machine paths, read by experiments/local_env.py at import of the modules
# that need them. Copy to .env (gitignored) and edit for this machine; the
# values below are the acquisition workstation's. Anything already exported in
# the environment takes precedence over this file.

# Root of the experiment data tree (experiments/job_paths.py).
# Laptop over SMB, e.g. /Volumes/pippin/experiments
MULTIMODE_DATA_ROOT=C:/experiments

# Config version archive (experiments/floquet_timing.py). Defaults to the
# in-repo configs/versions/, which is gitignored and so often absent off-prod.
MULTIMODE_CONFIG_ARCHIVE=C:/python/multimode_expts/configs/versions

# Config store of the main checkout, for the measurement-notebook session
# helper (experiments/qsim/notebook_helpers/qsim_session.py).
MULTIMODE_CONFIG_DIR=C:/python/multimode_expts/configs

# Job -> path resolution strategy: provenance (default), index, vault.
#MULTIMODE_PATH_BACKEND=provenance

# Provenance sidecar, if not tests/data/job_provenance.json.
#MULTIMODE_PROVENANCE=

# The synced Obsidian vault root (the directory holding Lab/), plus the
# lab-notebook user directory inside it. Needed by the 'vault' backend and by
# MBR_analysis.vault_paths; on macOS the Drive root is under
# ~/Library/CloudStorage/GoogleDrive-<account>/.
#MULTIMODE_VAULT_ROOT=G:/Shared drives/SLab/Multimode
#MULTIMODE_VAULT_USER=guan

# Mock-mode output root. Default: C:/experiments/mock_data on the measurement
# PC, the system temp directory elsewhere.
#MULTIMODE_MOCK_DATA_ROOT=

# The main checkout's job database and worker lock, for the notebook test
# suite (tools/run_qsim_suite.py): --configs main reads the main config
# versions from the database, and a sandbox run holds the worker lock. The
# defaults are the measurement PC's.
#MULTIMODE_MAIN_JOBS_DB=C:/python/multimode_expts/job_server/jobs.db
#MULTIMODE_MAIN_WORKER_LOCK=C:/python/multimode_expts/job_server/worker.lock
